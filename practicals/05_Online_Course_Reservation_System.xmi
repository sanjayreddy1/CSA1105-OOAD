  <uml:Model xmi:id="model_1" name="Online Course Reservation System">
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_usecase" name="UseCaseView">
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_0" name="Student"/>
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_1" name="University"/>
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_2" name="Central Management System"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_0" name="Browse Courses"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_1" name="Select Course">
        <include xmi:type="uml:Include" xmi:id="inc_1" addition="uc_2"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_2" name="Check Seat Availability"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_3" name="Enroll in Course">
        <include xmi:type="uml:Include" xmi:id="inc_2" addition="uc_5"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_4" name="Confirm Enrollment"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_5" name="Update Seat Count"/>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_0" name="Student - Browse Courses" memberEnd="ua_0_1 ua_0_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_0_1" type="actor_0" association="ua_0"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_0_2" type="uc_0" association="ua_0"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_1" name="Student - Select Course" memberEnd="ua_1_1 ua_1_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_1_1" type="actor_0" association="ua_1"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_1_2" type="uc_1" association="ua_1"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_2" name="University - Check Seat Availability" memberEnd="ua_2_1 ua_2_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_2_1" type="actor_1" association="ua_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_2_2" type="uc_2" association="ua_2"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_3" name="University - Enroll in Course" memberEnd="ua_3_1 ua_3_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_3_1" type="actor_1" association="ua_3"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_3_2" type="uc_3" association="ua_3"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_4" name="Student - Confirm Enrollment" memberEnd="ua_4_1 ua_4_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_4_1" type="actor_0" association="ua_4"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_4_2" type="uc_4" association="ua_4"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_5" name="Central Management System - Update Seat Count" memberEnd="ua_5_1 ua_5_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_5_1" type="actor_2" association="ua_5"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_5_2" type="uc_5" association="ua_5"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_6" name="Central Management System - Check Seat Availability" memberEnd="ua_6_1 ua_6_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_6_1" type="actor_2" association="ua_6"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_6_2" type="uc_2" association="ua_6"/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_class" name="ClassView">
      <packagedElement xmi:type="uml:Class" xmi:id="cls_0" name="Student">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_0_at0" name="studentId" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_0_at1" name="name" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_0_at2" name="email" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_0_op0" name="browseCourses()" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_0_op1" name="selectCourse()" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_1" name="University">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_1_at0" name="universityName" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_1_op0" name="checkSeatAvailability()" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_1_op1" name="enrollStudent()" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_2" name="CentralManagementSystem">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_2_at0" name="courseRecords" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_2_op0" name="updateSeatCount()" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_2_op1" name="organizeCourses()" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_3" name="Course">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_3_at0" name="courseId" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_3_at1" name="title" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_3_at2" name="totalSeats" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_3_at3" name="availableSeats" visibility="private"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_4" name="Enrollment">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_4_at0" name="enrollmentId" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_4_at1" name="date" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_4_at2" name="status" visibility="private"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_0" name="selects" memberEnd="ca_0_1 ca_0_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_0_1" name="student" type="cls_0" association="ca_0"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_0_2" name="course" type="cls_3" association="ca_0"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_1" name="offers" memberEnd="ca_1_1 ca_1_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_1_1" name="university" type="cls_1" association="ca_1"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_1_2" name="course" type="cls_3" association="ca_1"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_2" name="has" memberEnd="ca_2_1 ca_2_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_2_1" name="student" type="cls_0" association="ca_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_2_2" name="enrollment" type="cls_4" association="ca_2"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_3" name="for" memberEnd="ca_3_1 ca_3_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_3_1" name="enrollment" type="cls_4" association="ca_3"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_3_2" name="course" type="cls_3" association="ca_3"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_4" name="organizes" memberEnd="ca_4_1 ca_4_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_4_1" name="centralManagementSystem" type="cls_2" association="ca_4"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_4_2" name="university" type="cls_1" association="ca_4"/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_seq" name="SequenceView">
      <packagedElement xmi:type="uml:Collaboration" xmi:id="collab_1" name="Collaboration">
        <ownedAttribute xmi:type="uml:Property" xmi:id="role_0" name="student" type="cls_0"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="role_1" name="university" type="cls_1"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="role_2" name="centralManagementSystem" type="cls_2"/>
        <ownedBehavior xmi:type="uml:Interaction" xmi:id="int_1" name="Online Course Reservation System Sequence">
          <lifeline xmi:type="uml:Lifeline" xmi:id="ll_0" name="Student" represents="role_0" coveredBy="os_0s os_3r"/>
          <lifeline xmi:type="uml:Lifeline" xmi:id="ll_1" name="University" represents="role_1" coveredBy="os_0r os_1s os_2r os_3s os_4s"/>
          <lifeline xmi:type="uml:Lifeline" xmi:id="ll_2" name="CentralManagementSystem" represents="role_2" coveredBy="os_1r os_2s os_4r"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_0s" covered="ll_0" message="msg_0"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_0r" covered="ll_1" message="msg_0"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_1s" covered="ll_1" message="msg_1"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_1r" covered="ll_2" message="msg_1"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_2s" covered="ll_2" message="msg_2"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_2r" covered="ll_1" message="msg_2"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_3s" covered="ll_1" message="msg_3"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_3r" covered="ll_0" message="msg_3"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_4s" covered="ll_1" message="msg_4"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_4r" covered="ll_2" message="msg_4"/>
          <message xmi:type="uml:Message" xmi:id="msg_0" name="1: selectCourse()" messageSort="synchCall" sendEvent="os_0s" receiveEvent="os_0r"/>
          <message xmi:type="uml:Message" xmi:id="msg_1" name="2: checkSeatAvailability()" messageSort="synchCall" sendEvent="os_1s" receiveEvent="os_1r"/>
          <message xmi:type="uml:Message" xmi:id="msg_2" name="3: seatAvailable()" messageSort="synchCall" sendEvent="os_2s" receiveEvent="os_2r"/>
          <message xmi:type="uml:Message" xmi:id="msg_3" name="4: enrollStudent()" messageSort="synchCall" sendEvent="os_3s" receiveEvent="os_3r"/>
          <message xmi:type="uml:Message" xmi:id="msg_4" name="5: updateSeatCount()" messageSort="synchCall" sendEvent="os_4s" receiveEvent="os_4r"/>
        </ownedBehavior>
      </packagedElement>
    </packagedElement>
