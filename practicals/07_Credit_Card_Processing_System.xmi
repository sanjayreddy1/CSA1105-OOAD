<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:uml="http://www.omg.org/spec/UML/20090901" xmlns:umldi="http://www.omg.org/spec/UML/20131001/UMLDI" xmlns:di="http://www.omg.org/spec/DD/20110901/DI" xmlns:dc="http://www.omg.org/spec/DD/20110901/DC">
  <uml:Model xmi:id="model_1" name="Credit Card Processing System">
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_usecase" name="UseCaseView">
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_0" name="Cardholder"/>
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_1" name="Cashier"/>
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_2" name="Central System"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_0" name="Select Items to Purchase"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_1" name="Present Credit Card">
        <include xmi:type="uml:Include" xmi:id="inc_1" addition="uc_2"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_2" name="Accept Card"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_3" name="Process Transaction">
        <include xmi:type="uml:Include" xmi:id="inc_2" addition="uc_4"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_4" name="Verify Bill"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_5" name="Pay Bill"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_6" name="Deliver Items"/>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_0" name="Cardholder - Select Items to Purchase" memberEnd="ua_0_1 ua_0_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_0_1" type="actor_0" association="ua_0"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_0_2" type="uc_0" association="ua_0"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_1" name="Cardholder - Present Credit Card" memberEnd="ua_1_1 ua_1_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_1_1" type="actor_0" association="ua_1"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_1_2" type="uc_1" association="ua_1"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_2" name="Cashier - Accept Card" memberEnd="ua_2_1 ua_2_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_2_1" type="actor_1" association="ua_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_2_2" type="uc_2" association="ua_2"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_3" name="Cashier - Process Transaction" memberEnd="ua_3_1 ua_3_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_3_1" type="actor_1" association="ua_3"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_3_2" type="uc_3" association="ua_3"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_4" name="Central System - Process Transaction" memberEnd="ua_4_1 ua_4_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_4_1" type="actor_2" association="ua_4"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_4_2" type="uc_3" association="ua_4"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_5" name="Central System - Verify Bill" memberEnd="ua_5_1 ua_5_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_5_1" type="actor_2" association="ua_5"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_5_2" type="uc_4" association="ua_5"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_6" name="Cardholder - Pay Bill" memberEnd="ua_6_1 ua_6_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_6_1" type="actor_0" association="ua_6"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_6_2" type="uc_5" association="ua_6"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_7" name="Cashier - Deliver Items" memberEnd="ua_7_1 ua_7_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_7_1" type="actor_1" association="ua_7"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_7_2" type="uc_6" association="ua_7"/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_class" name="ClassView">
      <packagedElement xmi:type="uml:Class" xmi:id="cls_0" name="Cardholder">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_0_at0" name="cardholderId" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_0_at1" name="name" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_0_at2" name="address" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_0_op0" name="selectItems()" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_0_op1" name="payBill()" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_1" name="Cashier">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_1_at0" name="cashierId" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_1_at1" name="name" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_1_op0" name="acceptCard()" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_1_op1" name="startTransaction()" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_1_op2" name="deliverItems()" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_2" name="CentralSystem">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_2_at0" name="accountRecords" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_2_op0" name="processTransaction()" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_2_op1" name="verifyBill()" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_3" name="CreditCard">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_3_at0" name="cardNumber" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_3_at1" name="expiryDate" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_3_at2" name="creditLimit" visibility="private"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_4" name="Bill">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_4_at0" name="billNo" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_4_at1" name="amount" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_4_at2" name="date" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_4_at3" name="status" visibility="private"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_0" name="owns" memberEnd="ca_0_1 ca_0_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_0_1" name="cardholder" type="cls_0" association="ca_0"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_0_2" name="creditCard" type="cls_3" association="ca_0"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_1" name="pays to" memberEnd="ca_1_1 ca_1_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_1_1" name="cardholder" type="cls_0" association="ca_1"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_1_2" name="cashier" type="cls_1" association="ca_1"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_2" name="uses" memberEnd="ca_2_1 ca_2_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_2_1" name="cashier" type="cls_1" association="ca_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_2_2" name="centralSystem" type="cls_2" association="ca_2"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_3" name="verifies" memberEnd="ca_3_1 ca_3_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_3_1" name="centralSystem" type="cls_2" association="ca_3"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_3_2" name="bill" type="cls_4" association="ca_3"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_4" name="charged for" memberEnd="ca_4_1 ca_4_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_4_1" name="creditCard" type="cls_3" association="ca_4"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_4_2" name="bill" type="cls_4" association="ca_4"/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_seq" name="SequenceView">
      <packagedElement xmi:type="uml:Collaboration" xmi:id="collab_1" name="Collaboration">
        <ownedAttribute xmi:type="uml:Property" xmi:id="role_0" name="cardholder" type="cls_0"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="role_1" name="cashier" type="cls_1"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="role_2" name="centralSystem" type="cls_2"/>
        <ownedBehavior xmi:type="uml:Interaction" xmi:id="int_1" name="Credit Card Processing System Sequence">
          <lifeline xmi:type="uml:Lifeline" xmi:id="ll_0" name="Cardholder" represents="role_0" coveredBy="os_0s os_4r"/>
          <lifeline xmi:type="uml:Lifeline" xmi:id="ll_1" name="Cashier" represents="role_1" coveredBy="os_0r os_1s os_3r os_4s"/>
          <lifeline xmi:type="uml:Lifeline" xmi:id="ll_2" name="CentralSystem" represents="role_2" coveredBy="os_1r os_2s os_2r os_3s"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_0s" covered="ll_0" message="msg_0"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_0r" covered="ll_1" message="msg_0"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_1s" covered="ll_1" message="msg_1"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_1r" covered="ll_2" message="msg_1"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_2s" covered="ll_2" message="msg_2"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_2r" covered="ll_2" message="msg_2"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_3s" covered="ll_2" message="msg_3"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_3r" covered="ll_1" message="msg_3"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_4s" covered="ll_1" message="msg_4"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_4r" covered="ll_0" message="msg_4"/>
          <message xmi:type="uml:Message" xmi:id="msg_0" name="1: presentCard()" messageSort="synchCall" sendEvent="os_0s" receiveEvent="os_0r"/>
          <message xmi:type="uml:Message" xmi:id="msg_1" name="2: processTransaction()" messageSort="synchCall" sendEvent="os_1s" receiveEvent="os_1r"/>
          <message xmi:type="uml:Message" xmi:id="msg_2" name="3: verifyBill()" messageSort="synchCall" sendEvent="os_2s" receiveEvent="os_2r"/>
          <message xmi:type="uml:Message" xmi:id="msg_3" name="4: approval()" messageSort="reply" sendEvent="os_3s" receiveEvent="os_3r"/>
          <message xmi:type="uml:Message" xmi:id="msg_4" name="5: deliverItems()" messageSort="synchCall" sendEvent="os_4s" receiveEvent="os_4r"/>
        </ownedBehavior>
      </packagedElement>
    </packagedElement>
  </uml:Model>
