  <uml:Model xmi:id="model_1" name="Exam Registration Portal">
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_usecase" name="UseCaseView">
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_0" name="Candidate"/>
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_1" name="Administrator"/>
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_2" name="Central Computer"/>
      <packagedElement xmi:type="uml:Actor" xmi:id="actor_3" name="Exam Office"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_0" name="Register for Exam">
        <include xmi:type="uml:Include" xmi:id="inc_1" addition="uc_1"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_1" name="Submit Candidate Details"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_2" name="Forward Details to Central Computer"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_3" name="Verify Candidate Details"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_4" name="Provide Approval">
        <include xmi:type="uml:Include" xmi:id="inc_2" addition="uc_3"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_5" name="Issue Hall Ticket">
        <include xmi:type="uml:Include" xmi:id="inc_3" addition="uc_4"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_6" name="Receive Hall Ticket"/>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_0" name="Candidate - Register for Exam" memberEnd="ua_0_1 ua_0_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_0_1" type="actor_0" association="ua_0"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_0_2" type="uc_0" association="ua_0"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_1" name="Candidate - Submit Candidate Details" memberEnd="ua_1_1 ua_1_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_1_1" type="actor_0" association="ua_1"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_1_2" type="uc_1" association="ua_1"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_2" name="Administrator - Forward Details to Central Computer" memberEnd="ua_2_1 ua_2_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_2_1" type="actor_1" association="ua_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_2_2" type="uc_2" association="ua_2"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_3" name="Central Computer - Verify Candidate Details" memberEnd="ua_3_1 ua_3_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_3_1" type="actor_2" association="ua_3"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_3_2" type="uc_3" association="ua_3"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_4" name="Central Computer - Provide Approval" memberEnd="ua_4_1 ua_4_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_4_1" type="actor_2" association="ua_4"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_4_2" type="uc_4" association="ua_4"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_5" name="Exam Office - Issue Hall Ticket" memberEnd="ua_5_1 ua_5_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_5_1" type="actor_3" association="ua_5"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_5_2" type="uc_5" association="ua_5"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ua_6" name="Candidate - Receive Hall Ticket" memberEnd="ua_6_1 ua_6_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_6_1" type="actor_0" association="ua_6"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ua_6_2" type="uc_6" association="ua_6"/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_class" name="ClassView">
      <packagedElement xmi:type="uml:Class" xmi:id="cls_0" name="Candidate">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_0_at0" name="candidateId" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_0_at1" name="name" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_0_at2" name="dateOfBirth" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_0_at3" name="examCode" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_0_op0" name="register()" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_0_op1" name="submitDetails()" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_0_op2" name="receiveHallTicket()" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_1" name="Administrator">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_1_at0" name="adminId" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_1_at1" name="name" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_1_op0" name="forwardDetails()" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_2" name="CentralComputer">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_2_at0" name="candidateDatabase" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_2_op0" name="verifyDetails()" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_2_op1" name="provideApproval()" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_3" name="ExamOffice">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_3_at0" name="officeId" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_3_op0" name="issueHallTicket()" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_4" name="HallTicket">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_4_at0" name="ticketNo" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_4_at1" name="examDate" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_4_at2" name="venue" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_4_at3" name="seatNo" visibility="private"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_0" name="gives details to" memberEnd="ca_0_1 ca_0_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_0_1" name="candidate" type="cls_0" association="ca_0"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_0_2" name="administrator" type="cls_1" association="ca_0"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_1" name="forwards to" memberEnd="ca_1_1 ca_1_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_1_1" name="administrator" type="cls_1" association="ca_1"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_1_2" name="centralComputer" type="cls_2" association="ca_1"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_2" name="approves for" memberEnd="ca_2_1 ca_2_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_2_1" name="centralComputer" type="cls_2" association="ca_2"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_2_2" name="examOffice" type="cls_3" association="ca_2"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_3" name="issues" memberEnd="ca_3_1 ca_3_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_3_1" name="examOffice" type="cls_3" association="ca_3"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_3_2" name="hallTicket" type="cls_4" association="ca_3"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_4" name="receives" memberEnd="ca_4_1 ca_4_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_4_1" name="candidate" type="cls_0" association="ca_4"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_4_2" name="hallTicket" type="cls_4" association="ca_4"/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_seq" name="SequenceView">
      <packagedElement xmi:type="uml:Collaboration" xmi:id="collab_1" name="Collaboration">
        <ownedAttribute xmi:type="uml:Property" xmi:id="role_0" name="candidate" type="cls_0"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="role_1" name="administrator" type="cls_1"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="role_2" name="centralComputer" type="cls_2"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="role_3" name="examOffice" type="cls_3"/>
        <ownedBehavior xmi:type="uml:Interaction" xmi:id="int_1" name="Exam Registration Portal Sequence">
          <lifeline xmi:type="uml:Lifeline" xmi:id="ll_0" name="Candidate" represents="role_0" coveredBy="os_0s os_4r"/>
          <lifeline xmi:type="uml:Lifeline" xmi:id="ll_1" name="Administrator" represents="role_1" coveredBy="os_0r os_1s"/>
          <lifeline xmi:type="uml:Lifeline" xmi:id="ll_2" name="CentralComputer" represents="role_2" coveredBy="os_1r os_2s os_2r os_3s"/>
          <lifeline xmi:type="uml:Lifeline" xmi:id="ll_3" name="ExamOffice" represents="role_3" coveredBy="os_3r os_4s"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_0s" covered="ll_0" message="msg_0"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_0r" covered="ll_1" message="msg_0"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_1s" covered="ll_1" message="msg_1"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_1r" covered="ll_2" message="msg_1"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_2s" covered="ll_2" message="msg_2"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_2r" covered="ll_2" message="msg_2"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_3s" covered="ll_2" message="msg_3"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_3r" covered="ll_3" message="msg_3"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_4s" covered="ll_3" message="msg_4"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_4r" covered="ll_0" message="msg_4"/>
          <message xmi:type="uml:Message" xmi:id="msg_0" name="1: submitDetails()" messageSort="synchCall" sendEvent="os_0s" receiveEvent="os_0r"/>
          <message xmi:type="uml:Message" xmi:id="msg_1" name="2: forwardDetails()" messageSort="synchCall" sendEvent="os_1s" receiveEvent="os_1r"/>
          <message xmi:type="uml:Message" xmi:id="msg_2" name="3: verifyDetails()" messageSort="synchCall" sendEvent="os_2s" receiveEvent="os_2r"/>
          <message xmi:type="uml:Message" xmi:id="msg_3" name="4: provideApproval()" messageSort="synchCall" sendEvent="os_3s" receiveEvent="os_3r"/>
          <message xmi:type="uml:Message" xmi:id="msg_4" name="5: issueHallTicket()" messageSort="synchCall" sendEvent="os_4s" receiveEvent="os_4r"/>
        </ownedBehavior>
      </packagedElement>
    </packagedElement>
  </uml:Model>
