    <packagedElement xmi:type="uml:Package" xmi:id="pkg_seq" name="SequenceView">
      <packagedElement xmi:type="uml:Collaboration" xmi:id="collab_1" name="Collaboration">
        <ownedAttribute xmi:type="uml:Property" xmi:id="role_0" name="reader" type="cls_0"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="role_1" name="centralSystem" type="cls_2"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="role_2" name="administrator" type="cls_1"/>
        <ownedBehavior xmi:type="uml:Interaction" xmi:id="int_1" name="E-Book Management System Sequence">
          <lifeline xmi:type="uml:Lifeline" xmi:id="ll_0" name="Reader" represents="role_0" coveredBy="os_0s"/>
          <lifeline xmi:type="uml:Lifeline" xmi:id="ll_1" name="CentralSystem" represents="role_1" coveredBy="os_0r os_1s os_1r os_2s os_2r os_3r os_4s"/>
          <lifeline xmi:type="uml:Lifeline" xmi:id="ll_2" name="Administrator" represents="role_2" coveredBy="os_3s os_4r"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_0s" covered="ll_0" message="msg_0"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_0r" covered="ll_1" message="msg_0"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_1s" covered="ll_1" message="msg_1"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_1r" covered="ll_1" message="msg_1"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_2s" covered="ll_1" message="msg_2"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_2r" covered="ll_1" message="msg_2"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_3s" covered="ll_2" message="msg_3"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_3r" covered="ll_1" message="msg_3"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_4s" covered="ll_1" message="msg_4"/>
          <fragment xmi:type="uml:OccurrenceSpecification" xmi:id="os_4r" covered="ll_2" message="msg_4"/>
          <message xmi:type="uml:Message" xmi:id="msg_0" name="1: readBook()" messageSort="synchCall" sendEvent="os_0s" receiveEvent="os_0r"/>
          <message xmi:type="uml:Message" xmi:id="msg_1" name="2: recordReading()" messageSort="synchCall" sendEvent="os_1s" receiveEvent="os_1r"/>
          <message xmi:type="uml:Message" xmi:id="msg_2" name="3: storeDetails()" messageSort="synchCall" sendEvent="os_2s" receiveEvent="os_2r"/>
          <message xmi:type="uml:Message" xmi:id="msg_3" name="4: triggerBackup()" messageSort="synchCall" sendEvent="os_3s" receiveEvent="os_3r"/>
          <message xmi:type="uml:Message" xmi:id="msg_4" name="5: backupDone()" messageSort="reply" sendEvent="os_4s" receiveEvent="os_4r"/>
        </ownedBehavior>
      </packagedElement>
    </packagedElement>
