        <ownedEnd xmi:type="uml:Property" xmi:id="ca_0_2" name="eBook" type="cls_3" association="ca_0"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_1" name="has" memberEnd="ca_1_1 ca_1_2">
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_1_1" name="reader" type="cls_0" association="ca_1"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ca_1_2" name="readingRecord" type="cls_4" association="ca_1"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="ca_2" name="refers to" memberEnd="ca_2_1 ca_2_2">
