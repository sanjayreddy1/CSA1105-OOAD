        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_1_at1" name="name" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_1_op0" name="manageBooks()" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="cls_1_op1" name="triggerBackup()" visibility="public"/>
